# MF-18 / MF-36: the ONLY root access the app user gets. Installed by deploy/install.sh to
# /etc/sudoers.d/memoryframe (0440, checked with visudo -c). @USER@ is replaced.
# The helper is a root-owned copy (/usr/local/sbin), not the app-writable checkout.
# The new password is passed on stdin, never on the command line (sudo logs argv).
@USER@ ALL=(root) NOPASSWD: /usr/local/sbin/memoryframe-netmode wifi-apply, /usr/local/sbin/memoryframe-netmode wifi-commit, /usr/local/sbin/memoryframe-netmode wifi-rollback
