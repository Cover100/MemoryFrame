# Memory Frame web app (waitress). Installed by deploy/install.sh, which
# replaces @USER@ and @APP_DIR@.
[Unit]
Description=Memory Frame web app
After=network.target
# Restart forever, even after repeated crashes.
StartLimitIntervalSec=0

[Service]
# #95: the app sends READY=1 and WATCHDOG=1 (memoryframe/watchdog.py); a hang is killed after 90 s.
Type=notify
NotifyAccess=main
WatchdogSec=90
TimeoutAbortSec=10
LimitCORE=0
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=MEMORYFRAME_DATA_DIR=/var/lib/memoryframe
Environment=MEMORYFRAME_LEGACY_UPLOADS=@APP_DIR@/uploads
# MF-10: port 80 (http://10.42.0.1/, the NFC tag URL) plus 5000 for existing tools.
Environment=MEMORYFRAME_PORTS=80,5000
# Allow binding port 80 without running as root; nothing else is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# #62 hardening: no privilege gain at all (no sudo/setuid). Developer Wi-Fi, Wi-Fi change and Shut down
# are root oneshot units / logind poweroff that polkit lets only this user start (memoryframe-polkit.rules).
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/memoryframe -@APP_DIR@/uploads
# Wi-Fi apply input (ssid/password) is handed to the root unit through this 0700 directory.
RuntimeDirectory=memoryframe-app
RuntimeDirectoryMode=0700
# MF-13: optional settings, e.g. MEMORYFRAME_EXTRA_HOSTS=192.168.50.124 to open the site
# from the home network. Written by: deploy/install.sh --extra-hosts LIST
# (or deploy/env-file.sh). The leading "-" means the file may be absent.
EnvironmentFile=-/etc/default/memoryframe
# Environment=MEMORYFRAME_EXTRA_HOSTS=192.168.50.124
# Environment=MEMORYFRAME_SITE_URL=http://memoryframe.local
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/app.py
# #82: memory. The Pi 4B has 4 GB shared with the kiosk Chromium; one huge photo decode (HEIC/PNG/WebP up to
# ~0.8 GB at the 50 MP cap) must not starve it. The protections that actually work on the Pi are in the app:
# the 50 MP non-JPEG cap, the JPEG draft (reduced-size) decode, the single-decode lock, and
# MALLOC_ARENA_MAX=1 below: glibc keeps per-thread arenas and doesn't hand memory back after non-JPEG decodes
# (waitress has 4 threads); measured on the Pi, three 48 MP WebPs in a row peaked at 1.3-2.4 GB without it
# and ~880 MB with it, dropping back to ~140 MB afterwards.
# MemoryHigh/MemoryMax are only enforced if the kernel has the memory cgroup controller enabled. Raspberry Pi
# OS boots with cgroup_disable=memory by default, so on the stock Pi kernel they are harmless no-ops (they take
# effect on a kernel/boot config with the controller on). Do not rely on them.
Environment=MALLOC_ARENA_MAX=1
MemoryHigh=2G
MemoryMax=2500M
# #96: no core dumps (a watchdog abort of a large process must not fill the card)
LimitCORE=0
Restart=always
RestartSec=2
# #95: crash loops back off 2 s -> 60 s and never give up (systemd 254+).
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=multi-user.target
