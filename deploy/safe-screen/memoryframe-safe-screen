#!/bin/sh
# Late shutdown hook (MF-49): installed to /usr/lib/systemd/system-shutdown/. systemd-shutdown
# runs it after all services have stopped and filesystems are unmounted or read-only, i.e. when
# it is genuinely safe to unplug. On poweroff/halt it writes the "Safe to unplug" image to fb0.
# Arg 1: halt | poweroff | reboot | kexec. Test hooks: MF_FB, MF_FB_SYS, MF_ASSETS.
FB="${MF_FB:-/dev/fb0}"
SYS="${MF_FB_SYS:-/sys/class/graphics/fb0}"
ASSETS="${MF_ASSETS:-/usr/lib/memoryframe}"
case "${1:-}" in poweroff|halt) ;; *) exit 0 ;; esac
[ -e "$FB" ] || exit 0
bpp="$(cat "$SYS/bits_per_pixel" 2>/dev/null)"
size="$(cat "$SYS/virtual_size" 2>/dev/null)"
[ "$size" = "800,480" ] || exit 0
case "$bpp" in
    32) img="$ASSETS/safe-to-unplug.xrgb8888" ;;
    16) img="$ASSETS/safe-to-unplug.rgb565" ;;
    *) exit 0 ;;
esac
[ -r "$img" ] && cat "$img" > "$FB" 2>/dev/null
exit 0
